# Режим: demo (эмуляторы, демопанель) | production (только при наличии настроенных адаптеров и LaunchApproval)
APP_MODE=demo
DATABASE_URL=postgresql://talisman:talisman@localhost:5432/talisman
TEST_DATABASE_URL=postgresql://talisman:talisman@localhost:5432/talisman_test
APP_URL=http://localhost:3000
# Секрет подписи ссылок на скачивание и сессионных токенов (в demo можно оставить)
APP_SECRET=demo-only-secret-change-me-0123456789abcdef
# Секрет HMAC подписи вебхуков эмулятора платежей (в demo фиксированный)
DEMO_PAYMENT_WEBHOOK_SECRET=demo-webhook-secret
STORAGE_DIR=./storage/private
# Реальные адаптеры (P1). Пустые значения в production блокируют операции.
CARRIER_API_URL=
PAYMENT_PROVIDER_KEY=
SIGNATURE_PROVIDER_KEY=
WEATHER_PROVIDER_KEY=
AI_PROVIDER_KEY=
